#!/usr/bin/python3
"""Log the image revision once at start and then every 10 minutes."""
import platform
import time

def revision():
    try:
        with open("/usr/lib/box1-poc-release") as f:
            return f.read().strip()
    except OSError:
        return "BOX1_POC_REVISION=unknown"

while True:
    print(f"box1-poc alive on {platform.machine()} {revision()}", flush=True)
    time.sleep(600)
